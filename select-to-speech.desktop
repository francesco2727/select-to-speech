[Desktop Entry]
Type=Application
Name=Select to Speech
GenericName=Text to Speech
Comment=Read selected text aloud with a keyboard shortcut
Exec=%h/.local/bin/select-to-speech-gui
Icon=%h/.local/share/icons/hicolor/scalable/apps/select-to-speech.svg
Categories=AudioVideo;Audio;Utility;Accessibility;
Keywords=tts;speech;text;read;voice;
StartupNotify=false
NoDisplay=false
StartupWMClass=com.example.ui
Actions=Settings;

[Desktop Action Settings]
Name=Open Settings
Exec=%h/.local/bin/select-to-speech-settings
